# PostgreSQL connection string for Postgres running in Docker (or local)
RAILROUTE_DATABASE_URL="postgresql://master:railroute_pass@localhost:5432/railroute"

# IRCTC Credentials for Playwright scraper
IRCTC_USER="your_irctc_username"
IRCTC_PASS="your_irctc_password"

# Automation settings
SCRAPER_HEADLESS="false"
SCRAPER_MAX_TABS="6"
