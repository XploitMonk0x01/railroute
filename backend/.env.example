# PostgreSQL connection string
# Use Unix socket (postgresql:///railroute) for local dev on Linux to bypass password issues
RAILROUTE_DATABASE_URL="postgresql:///railroute"

# IRCTC Credentials for Playwright scraper
IRCTC_USER="your_irctc_username"
IRCTC_PASS="your_irctc_password"

# Automation settings
SCRAPER_HEADLESS="false"
SCRAPER_MAX_TABS="6"
