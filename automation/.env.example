# ─────────────────────────────────────────────────────────────
#  RailRoute Automation — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# IRCTC Credentials (required for login-gated availability checks)
IRCTC_USER=your_irctc_username
IRCTC_PASS=your_irctc_password

# PostgreSQL connection string (same as backend default)
RAILROUTE_DATABASE_URL=postgresql://master@127.0.0.1:5432/railroute

# Scraper behaviour
# Set to "true" to run Chrome without a visible window (CI / server mode)
SCRAPER_HEADLESS=false

# Default quota to check (GN = General, TQ = Tatkal, PT = Premium Tatkal)
SCRAPER_DEFAULT_QUOTA=GN

# Scheduler poll interval in minutes (used by scheduler.py)
SCRAPER_POLL_INTERVAL_MINUTES=30

# Maximum parallel browser tabs per scrape batch
SCRAPER_MAX_TABS=6
